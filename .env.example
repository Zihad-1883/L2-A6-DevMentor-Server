# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=https://dev-mentor-server.vercel.app

# Database Connections (Neon / Prisma PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-cool-pool.region.aws.neon.tech/neondb?sslmode=require"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
BETTER_AUTH_URL="https://dev-mentor-server.vercel.app"

# OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# bKash Payment Gateway (Sandbox)
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"
BKASH_USERNAME="your-bkash-username"
BKASH_PASSWORD="your-bkash-password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
